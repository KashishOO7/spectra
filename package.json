{
  "name": "spectra",
  "version": "1.0.0",
  "description": "Personal Security Self-Audit Framework by FPSZero",
  "license": "AGPL-3.0-only AND CC-BY-SA-4.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "tsx scripts/check-internals.ts && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts && tsx scripts/check-internals.ts && tsx scripts/check-protected.ts && tsx scripts/check-prose.ts",
    "maintain": "tsx scripts/maintain.ts",
    "new:item": "tsx scripts/new-item.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:internals": "tsx scripts/check-internals.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.4",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.0",
    "autoprefixer": "^10.4.19",
    "postcss-load-config": "^5.0.0",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "qrcode-generator": "^2.0.4"
  },
  "type": "module"
}
